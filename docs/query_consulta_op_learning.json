{
  "funcao": "query_consulta_op",
  "versao": "1.0",
  "descricao": "Documentação completa para consultas operacionais e analytics",

  "objetivo": "Ensinar o agente a analisar perguntas sobre quantidade de pedidos, peças, status, períodos e tipos de cliente",

  "identificacao_automatica": {
    "descricao": "Como identificar se a pergunta é uma consulta operacional (agregação) vs consulta de NF específica",
    "regras_principais": [
      "Se há um número específico (5+ dígitos) isolado ou após 'nota/NF/pedido' → consulta de NF individual",
      "Se há palavras de agregação (quantos, total, quanto, soma) SEM número específico → consulta operacional",
      "Se pergunta sobre período (hoje, ontem, semana) sem número de NF → consulta operacional",
      "Se pergunta sobre status geral (expedidos, importados) sem número → consulta operacional"
    ],
    "palavras_indicadoras_operacional": [
      "quantos",
      "quantas",
      "quanto",
      "total",
      "soma",
      "número de",
      "quantidade de",
      "foram expedidos",
      "foram importados",
      "em fluxo",
      "do dia",
      "de hoje",
      "de ontem",
      "dessa semana"
    ],
    "palavras_indicadoras_nf_individual": [
      "nota 12345",
      "NF 67890",
      "pedido 11111",
      "rastreio",
      "cadê",
      "onde está",
      "status da nota",
      "meu pedido [número]"
    ],
    "exemplos_diferenciacao": [
      {
        "pergunta": "Quantos pedidos foram expedidos hoje?",
        "tipo": "operacional",
        "motivo": "Palavra 'quantos' indica agregação, sem número específico de NF"
      },
      {
        "pergunta": "Status da nota 12345",
        "tipo": "nota_fiscal",
        "motivo": "Número específico 12345 após palavra 'nota'"
      },
      {
        "pergunta": "Pedidos em fluxo",
        "tipo": "operacional",
        "motivo": "Pergunta sobre status geral sem número específico"
      },
      {
        "pergunta": "Cadê meu pedido 67890?",
        "tipo": "nota_fiscal",
        "motivo": "Número específico 67890 após 'pedido'"
      },
      {
        "pergunta": "Total de peças expedidas essa semana",
        "tipo": "operacional",
        "motivo": "Palavra 'total' indica agregação + período temporal"
      },
      {
        "pergunta": "98765",
        "tipo": "nota_fiscal",
        "motivo": "Apenas um número com 5+ dígitos = provável número de NF"
      }
    ]
  },

  "colunas_disponiveis": {
    "NOTA_FISCAL": {
      "nome": "Nota Fiscal",
      "tipo": "Identificador",
      "uso": "CONTAGEM",
      "quando_usar": "Para contar QUANTIDADE DE PEDIDOS",
      "exemplos": [
        "Quantos pedidos foram expedidos? → COUNT(NOTA_FISCAL)",
        "Total de notas importadas → COUNT(NOTA_FISCAL)",
        "Número de pedidos B2C → COUNT(NOTA_FISCAL)"
      ],
      "importante": "Cada nota fiscal = 1 pedido. Use para contagem de pedidos!"
    },

    "CLASSIFICACAO_CODIGO": {
      "nome": "Classificação Código",
      "tipo": "Texto",
      "uso": "FILTRO",
      "quando_usar": "Para filtrar entre B2B e B2C",
      "regras_importantes": [
        "INSIDER_B2C* = Cliente B2C (consumidor final)",
        "INSIDER_B2B* = Cliente B2B (empresa)",
        "Tudo que começa com INSIDER_B2C é B2C",
        "Tudo que começa com INSIDER_B2B é B2B"
      ],
      "exemplos": [
        {
          "pergunta": "Pedidos B2C de hoje",
          "filtro": "CLASSIFICACAO_CODIGO LIKE 'INSIDER_B2C%'"
        },
        {
          "pergunta": "Quantas notas B2B foram expedidas?",
          "filtro": "CLASSIFICACAO_CODIGO LIKE 'INSIDER_B2B%'"
        }
      ]
    },

    "STATUS": {
      "nome": "Status",
      "tipo": "Texto",
      "uso": "FILTRO",
      "quando_usar": "Para filtrar por etapa do processo",
      "valores_possiveis": [
        "FATURADO - Nota fiscal emitida",
        "EXPEDIDO - Pedido já saiu/foi despachado",
        "IMPORTADO - Pedido entrou no sistema/em fluxo",
        "CANCELADO - Pedido cancelado",
        "SEPARACAO - Pedido sendo preparado",
        "CONFERIDO - Pedido já foi conferido"
      ],
      "mapeamento_linguagem_natural": {
        "expedido": ["expedidos", "despachados", "saiu", "enviados", "entregues"],
        "importado": ["importados", "em fluxo", "no sistema", "processando"],
        "faturado": ["faturados", "com nota emitida"],
        "separacao": ["em separação", "sendo preparados", "na separação"],
        "cancelado": ["cancelados", "canceladas"]
      },
      "exemplos": [
        {
          "pergunta": "Quantos pedidos foram expedidos hoje?",
          "filtro": "STATUS = 'EXPEDIDO'"
        },
        {
          "pergunta": "Pedidos em fluxo",
          "filtro": "STATUS = 'IMPORTADO'"
        }
      ]
    },

    "IMPORTADO_EM": {
      "nome": "Importado Em",
      "tipo": "Data/Hora",
      "uso": "FILTRO DE DATA",
      "significado": "Data de ENTRADA no sistema",
      "quando_usar": "Use esta coluna quando o status NÃO for EXPEDIDO",
      "regras_criticas": [
        "Se STATUS = IMPORTADO → use IMPORTADO_EM",
        "Se STATUS = FATURADO → use IMPORTADO_EM",
        "Se STATUS = SEPARACAO → use IMPORTADO_EM",
        "Se STATUS = CANCELADO → use IMPORTADO_EM",
        "Se STATUS = EXPEDIDO → NÃO USE, use PESADO_EM!"
      ],
      "exemplos": [
        {
          "pergunta": "Quantos pedidos foram importados hoje?",
          "coluna_usar": "IMPORTADO_EM",
          "explicacao": "STATUS=IMPORTADO então usa IMPORTADO_EM"
        },
        {
          "pergunta": "Pedidos em fluxo de ontem",
          "coluna_usar": "IMPORTADO_EM",
          "explicacao": "Em fluxo = IMPORTADO, então usa IMPORTADO_EM"
        },
        {
          "pergunta": "Notas faturadas essa semana",
          "coluna_usar": "IMPORTADO_EM",
          "explicacao": "STATUS=FATURADO então usa IMPORTADO_EM"
        }
      ]
    },

    "PESADO_EM": {
      "nome": "Pesado Em",
      "tipo": "Data/Hora",
      "uso": "FILTRO DE DATA",
      "significado": "Data de SAÍDA/EXPEDIÇÃO",
      "quando_usar": "Use APENAS quando o status for EXPEDIDO",
      "regras_criticas": [
        "Se STATUS = EXPEDIDO → SEMPRE use PESADO_EM",
        "PESADO_EM = data que o pedido saiu/foi despachado",
        "Para qualquer outro status, use IMPORTADO_EM"
      ],
      "exemplos": [
        {
          "pergunta": "Quantos pedidos foram expedidos hoje?",
          "coluna_usar": "PESADO_EM",
          "explicacao": "STATUS=EXPEDIDO então SEMPRE usa PESADO_EM"
        },
        {
          "pergunta": "Pedidos despachados ontem",
          "coluna_usar": "PESADO_EM",
          "explicacao": "Despachados = EXPEDIDO, então usa PESADO_EM"
        },
        {
          "pergunta": "Notas que saíram essa semana",
          "coluna_usar": "PESADO_EM",
          "explicacao": "Saíram = EXPEDIDO, então usa PESADO_EM"
        }
      ]
    },

    "QTDE": {
      "nome": "Quantidade",
      "tipo": "Número",
      "uso": "SOMA",
      "quando_usar": "Para contar QUANTIDADE DE PEÇAS/PRODUTOS",
      "exemplos": [
        "Quantas peças foram expedidas? → SUM(QTDE)",
        "Total de produtos importados → SUM(QTDE)",
        "Quantidade de itens B2C → SUM(QTDE)"
      ],
      "importante": "Use para somar peças/produtos, NÃO para contar pedidos!"
    },

    "DEPOSITANTE": {
      "nome": "Depositante",
      "tipo": "Identificador",
      "uso": "FILTRO",
      "quando_usar": "Para filtrar por empresa específica",
      "valores": [
        "2361178 - Empresa principal (buscar primeiro)",
        "538607 - Empresa secundária (buscar se não achar na primeira)"
      ]
    }
  },

  "logica_escolha_coluna_data": {
    "titulo": "REGRA CRÍTICA: Como escolher entre PESADO_EM e IMPORTADO_EM",
    "regra_principal": "A escolha da coluna de data depende EXCLUSIVAMENTE do STATUS",
    "fluxo_decisao": [
      "1. Identifique o STATUS na pergunta do usuário",
      "2. Se STATUS = EXPEDIDO → use PESADO_EM",
      "3. Se STATUS = qualquer outro → use IMPORTADO_EM"
    ],
    "tabela_decisao": {
      "EXPEDIDO": "PESADO_EM",
      "IMPORTADO": "IMPORTADO_EM",
      "FATURADO": "IMPORTADO_EM",
      "SEPARACAO": "IMPORTADO_EM",
      "CANCELADO": "IMPORTADO_EM",
      "CONFERIDO": "IMPORTADO_EM"
    },
    "exemplos_praticos": [
      {
        "pergunta": "Pedidos expedidos hoje",
        "status": "EXPEDIDO",
        "coluna_data": "PESADO_EM",
        "razao": "EXPEDIDO sempre usa PESADO_EM (data de saída)"
      },
      {
        "pergunta": "Pedidos importados hoje",
        "status": "IMPORTADO",
        "coluna_data": "IMPORTADO_EM",
        "razao": "IMPORTADO usa IMPORTADO_EM (data de entrada)"
      },
      {
        "pergunta": "Pedidos em fluxo de ontem",
        "status": "IMPORTADO",
        "coluna_data": "IMPORTADO_EM",
        "razao": "Em fluxo = IMPORTADO, então usa IMPORTADO_EM"
      },
      {
        "pergunta": "Notas faturadas essa semana",
        "status": "FATURADO",
        "coluna_data": "IMPORTADO_EM",
        "razao": "FATURADO não é EXPEDIDO, então usa IMPORTADO_EM"
      }
    ]
  },

